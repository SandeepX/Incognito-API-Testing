# Incognito Testing — deploy configuration
# Fill in APP_KEY (see README.md in this folder), then copy this file to `.env`.

# Port that will host the app (http://<host>:<APP_PORT>). Change on conflicts:
# APP_PORT=8080

APP_NAME="Incognito Testing"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=en

# REQUIRED: encryption key (`base64:...`). Generate once with:
#   docker run --rm incognitoman/incognito-api-testing:latest php artisan key:generate --show
# Keep it stable — changing it invalidates existing sessions/cookies.
APP_KEY=

LOG_LEVEL=warning

# Database (SQLite by default, stored in the `incognito-sqlite` volume)
DB_CONNECTION=sqlite

# --- To use MySQL instead: set DB_CONNECTION=mysql and add a mysql service
#     to docker-compose.yml (a ready-made block is in the repo's docker-compose.yml).
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=incognito
# DB_USERNAME=incognito
# DB_PASSWORD=secret

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
